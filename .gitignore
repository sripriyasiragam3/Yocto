# Ignore build artifacts and caches
build/
tmp/
downloads/
sstate-cache/
cache/
pstage/
buildtools/
*.log
*.swp
*.orig
*.rej
*~
*.pyc
*.pyo
 
# Ignore user/editor-specific files
*.swp
*.swo
*.bak
*.tmp
 
# Ignore Toaster and Eclipse generated docs
/documentation/
/bitbake/doc/bitbake-user-manual/*.pdf
/bitbake/doc/bitbake-user-manual/*.html
/bitbake/doc/bitbake-user-manual/*.tgz
 
# Don't ignore important meta layers
!meta-raspberrypi
!meta-openembedded
!meta-poky
!meta-yocto
!meta-yocto-bsp
!meta-custom
 
# Allow these if using skeleton or selftest layers
!meta-skeleton
!meta-selftest
 
# Repo/patch cleanup
/.repo/
/*.patch
 
